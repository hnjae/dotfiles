{
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "deny": ["WebSearch"]
  },
  "model": "haiku",
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "modelSettings": {
    "deepseek-v4.1-flash": {
      "autoCompactWindow": 500000
    },
    "minimax-m3.1-flash": {
      "autoCompactWindow": 500000
    }
  },
  "theme": "auto",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
