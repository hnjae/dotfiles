#!/usr/bin/env -S just --justfile

# SPDX-License-Identifier: AGPL-3.0-or-later
# SPDX-FileCopyrightText: 2022-2026 KIM Hyunjae

set unstable
set fallback
set lazy

_:
    @just --list

# The generated files age on different clocks: each catalog follows its
# provider's API, and the prompt follows the installed codex binary. Each one
# has its own generator in lib/ and its own update and check recipe here.

# Refresh every catalog. OpenRouter runs first because it needs no credentials.
models-update: models-update-openrouter models-update-mistral

# Refresh model-catalogs/mistral.json from the Mistral API (key from 1Password).
models-update-mistral:
    #!/bin/sh
    set -eu

    export MISTRAL_API_KEY="$(op read 'op://Personal/w57nor5w4jz3kt27372limfixu/credential')"

    "{{ justfile_directory() }}/lib/model-catalog-mistral.py"
    biome format --write "{{ justfile_directory() }}/model-catalogs/mistral.json"

# Refresh model-catalogs/openrouter.json from the public OpenRouter API.
models-update-openrouter:
    #!/bin/sh
    set -eu

    "{{ justfile_directory() }}/lib/model-catalog-openrouter.py"
    biome format --write "{{ justfile_directory() }}/model-catalogs/openrouter.json"

# Verify every catalog offline.
models-check: models-check-mistral models-check-openrouter

# Verify model-catalogs/mistral.json offline, without the API key.
models-check-mistral:
    #!/bin/sh
    set -eu

    exec "{{ justfile_directory() }}/lib/model-catalog-mistral.py" --check

# Verify model-catalogs/openrouter.json offline, without the API.
models-check-openrouter:
    #!/bin/sh
    set -eu

    exec "{{ justfile_directory() }}/lib/model-catalog-openrouter.py" --check

# Rewrite both provider prompt files from the installed codex prompt.
instructions-update:
    #!/bin/sh
    set -eu

    exec "{{ justfile_directory() }}/lib/base-instructions.py"

# Verify both provider prompt files against the installed codex prompt.
instructions-check:
    #!/bin/sh
    set -eu

    exec "{{ justfile_directory() }}/lib/base-instructions.py" --check

KILL-SERVER:
    pkill -f 'codex app-server'
