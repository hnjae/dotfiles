#!/usr/bin/env -S just --justfile

set unstable
set fallback
set lazy

_:
    @just --list

# Refresh model-catalogs/mistral.json from the Mistral API and the codex
# agent prompt pinned to the installed binary. The Mistral key comes from
# ~/.local/share/secrets/MISTRAL.env.
models-update:
    #!/usr/bin/env bash
    set -euo pipefail

    env_file="$HOME/.local/share/secrets/MISTRAL.env"
    # The secrets store may serve this as a named pipe, not a regular file.
    if [[ ! -e "$env_file" ]]; then
        echo "error: $env_file does not exist; put MISTRAL_API_KEY in it" >&2
        exit 1
    fi

    # set -a exports MISTRAL_API_KEY even if MISTRAL.env has no `export`.
    set -a
    # shellcheck disable=SC1090
    source "$env_file"
    set +a

    exec "{{ justfile_directory() }}/model-catalogs/update.py"

KILL-SERVER:
    pkill -f 'codex app-server'
