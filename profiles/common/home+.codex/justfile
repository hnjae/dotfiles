set unstable
set fallback
set lazy

_:
    @just --list

# Refresh model-catalogs/mistral.json from the Mistral API and the codex
# agent prompt pinned to the installed binary. The Mistral key comes from
# ~/.local/share/secrets/MISTRAL.env.
models-update:
    #!/bin/sh
    set -eu

    export MISTRAL_API_KEY="$(op read 'op://Personal/w57nor5w4jz3kt27372limfixu/credential')"

    "{{ justfile_directory() }}/model-catalogs/update.py"
    biome format --write "{{ justfile_directory() }}/model-catalogs/mistral.json"

# Verify the catalog prompt matches the installed codex version.
models-check:
    #!/bin/sh
    set -eu

    exec "{{ justfile_directory() }}/model-catalogs/update.py" --check

KILL-SERVER:
    pkill -f 'codex app-server'
