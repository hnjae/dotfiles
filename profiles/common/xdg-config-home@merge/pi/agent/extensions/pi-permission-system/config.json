{
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "cat *": "allow",
      "echo *": "allow",
      "exa *": "allow",
      "fd *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "ls *": "allow",
      "sed *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "bat *": "allow",
      "jq *": "allow",
      "rg *": "allow",
      "treefmt *": "allow",
      "ruff *": "allow",
      "cd *": "allow",
      "rm -rf *": "deny",
      "sudo *": "ask",
      "ssh *": "ask",
      "pi *": "ask"
    },
    "external_directory": {
      "*": "ask",
      "/tmp/*": "allow"
    },
    "external_directory_read": {
      "~/Projects/*": "allow",
      "~/git/*": "allow",
      "~/.local/share/dotfiles/*": "allow",
      "~/.cargo/registry/*": "allow",
      "~/.local/share/cargo/registry/*": "allow",
      "~/.local/share/bun/install/*": "allow",
      "~/.local/share/pnpm/*": "allow"
    }
  }
}
