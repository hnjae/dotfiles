{
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "exposure": "codemode"
    },
    "mdn": {
      "url": "https://mcp.mdn.mozilla.net/",
      "exposure": "direct"
    },
    "exa": {
      "url": "https://mcp.exa.ai/mcp",
      "description": "Exa web search and page fetch. web_search_exa (codemode) finds pages from a description of the ideal page; web_fetch_exa (direct) reads known URLs as clean markdown, several per call. Also offers MCP resources.",
      "toolExposure": {
        "web_fetch_exa": "direct",
        "web_search_exa": "codemode"
      }
    },
    "nixos": {
      "command": "uvx",
      "args": ["mcp-nixos"],
      "toolExposure": {
        "nix": "deferred",
        "nix_versions": "direct"
      }
    }
  }
}
