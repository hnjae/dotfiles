{
  "version": 1,
  "safety": {
    "level": "standard",
    "overrides": {}
  },
  "workflow": {
    "worktree_mode": false
  },
  "destructive_command_protection": {
    "enabled": true,
    "overrides": {},
    "allow_paths": []
  },
  "secret_protection": {
    "enabled": true,
    "overrides": {},
    "deny_paths": [
      "~/.config/sops",
      "~/.zsh_history",
      "~/.histfile",
      "~/.history",
      "~/.bash_history",
      "~/.python_history",
      "~/.psql_history",
      "~/.sqlite_history",
      "~/.node_repl_history",
      "~/.irb_history",
      "~/.local/state/zsh_history",
      "~/.local/state/bash/history",
      "~/.local/state/python_history",
      "~/.local/state/fish/fish_history",
      "~/.local/share/zsh/history",
      "~/.local/share/fish/fish_history",
      "~/.local/share/psql_history",
      "~/.config/fish/fish_history",
      "~/.cache/kitty/shell.history.json"
    ],
    "allow_paths": []
  },
  "audit": {
    "retention_days": 30
  }
}
