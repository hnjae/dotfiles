{
  "version": 1,
  "safety": {
    "level": "standard",
    "overrides": {}
  },
  "workflow": {
    "worktree_mode": false
  },
  "destructive_command_protection": {
    "enabled": true,
    "overrides": {
      "git.checkout-ambiguous": "off",
      "git.checkout-double-dash": "off",
      "git.checkout-force": "off",
      "git.checkout-ref-path": "off",
      "git.clean-force": "off",
      "git.reset-hard": "off",
      "git.reset-merge": "off",
      "git.restore-unstaged": "off",
      "git.restore-worktree": "off",
      "git.stash-clear": "off",
      "git.stash-drop": "off",
      "git.switch-discard-changes": "off",
      "git.switch-force": "off"
    },
    "allow_paths": []
  },
  "secret_protection": {
    "enabled": true,
    "overrides": {},
    "deny_paths": [
      "~/.config/sops",
      "~/.cloudflared/",
      "~/.config/ticktick-cli/config.json",
      "~/.local/share/kwalletd/",
      "~/.cache/thumbnails/",
      "~/.cache/nvim/",
      "~/.cache/mozilla/",
      "~/.bash_history",
      "~/.histfile",
      "~/.history",
      "~/.irb_history",
      "~/.node_repl_history",
      "~/.psql_history",
      "~/.python_history",
      "~/.sqlite_history",
      "~/.zsh_history",
      "~/.cache/kitty/shell.history.json",
      "~/.config/fish/fish_history",
      "~/.local/share/fish/fish_history",
      "~/.local/share/nix/repl-history",
      "~/.local/share/psql_history",
      "~/.local/share/zsh/history",
      "~/.local/state/bash/history",
      "~/.local/state/fish/fish_history",
      "~/.local/state/python_history",
      "~/.local/state/zsh_history",
      "~/.local/share/nvim/snacks/",
      "~/.local/state/nvim/blink/",
      "~/.local/state/nvim/sessions/",
      "~/.local/state/nvim/swap/",
      "~/.local/state/nvim/undo/",
      "~/.config/codexbar/config.json",
      "~/.config/1Password",
      "~/.config/BraveSoftware",
      "~/.config/chromium",
      "~/.config/google-chrome",
      "~/.config/google-chrome-beta",
      "~/.config/google-chrome-unstable",
      "~/.config/vivaldi",
      "~/.config/vivaldi-snapshot",
      "~/.config/microsoft-edge",
      "~/.config/microsoft-edge-dev",
      "~/.config/mozilla",
      "~/.config/kdeconnect",
      "~/.config/kagi-cli/config.toml",
      "~/.config/ticktick-cli/config.json"
    ],
    "allow_paths": []
  },
  "audit": {
    "retention_days": 30
  }
}
