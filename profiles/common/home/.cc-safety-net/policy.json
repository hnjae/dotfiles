{
  "version": 1,
  "safety": {
    "level": "standard",
    "overrides": {}
  },
  "workflow": {
    "worktree_mode": false
  },
  "destructive_command_protection": {
    "enabled": true,
    "overrides": {
      "git.checkout-ambiguous": "off",
      "git.checkout-double-dash": "off",
      "git.checkout-force": "off",
      "git.checkout-ref-path": "off",
      "git.clean-force": "off",
      "git.reset-hard": "off",
      "git.reset-merge": "off",
      "git.restore-unstaged": "off",
      "git.restore-worktree": "off",
      "git.stash-clear": "off",
      "git.stash-drop": "off",
      "git.switch-discard-changes": "off",
      "git.switch-force": "off"
    },
    "allow_paths": []
  },
  "secret_protection": {
    "enabled": true,
    "overrides": {},
    "deny_paths": [
      "~/.config/sops",
      "~/.zsh_history",
      "~/.histfile",
      "~/.history",
      "~/.bash_history",
      "~/.python_history",
      "~/.psql_history",
      "~/.sqlite_history",
      "~/.node_repl_history",
      "~/.irb_history",
      "~/.local/state/zsh_history",
      "~/.local/state/bash/history",
      "~/.local/state/python_history",
      "~/.local/state/fish/fish_history",
      "~/.local/share/zsh/history",
      "~/.local/share/fish/fish_history",
      "~/.local/share/psql_history",
      "~/.config/fish/fish_history",
      "~/.cache/kitty/shell.history.json",
      "~/.cloudflared/",
      "~/.pi/agent/sessions/",
      "~/.local/state/pi/sessions/"
    ],
    "allow_paths": []
  },
  "audit": {
    "retention_days": 30
  }
}
