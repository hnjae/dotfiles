{
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "model": "opus",
  "subagentPromptCacheTtl": "1h",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 700000
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 500000
    },
    "claude-haiku-5-5": {
      "effortLevel": "xhigh",
      "autoCompactWindow": 400000
    }
  },
  "advisorModel": "opus",
  "tui": "fullscreen",
  "theme": "auto",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true
}
