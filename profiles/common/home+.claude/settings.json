{
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "model": "haiku",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/sleep-inhibit.sh\" start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/sleep-inhibit.sh\" stop",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/sleep-inhibit.sh\" stop",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/sleep-inhibit.sh\" stop",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/sleep-inhibit.sh\" stop",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@latest",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "cc-plugin-you-should-know@builtin": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "subagentPromptCacheTtl": "1h",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 500000
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 500000
    },
    "claude-haiku-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 350000
    }
  },
  "advisorModel": "opus",
  "tui": "fullscreen",
  "theme": "auto",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true
}
