let
  nixpkgs = fetchTarball "https://github.com/cachix/devenv-nixpkgs/archive/refs/heads/rolling.tar.gz";
  pkgs = import nixpkgs {
    config = { };
    overlays = [ ];
  };
in
pkgs.mkShellNoCC {
  packages = with pkgs; [
    # >>> biome
    biome
    # <<< biome
    # >>> rust
    cargo
    clippy
    rustc
    rustfmt
    # The linker rustc calls; mkShellNoCC leaves it out.
    stdenv.cc
    # <<< rust
    cocogitto
    deadnix
    git
    just
    nixf-diagnose
    nixfmt
    prek
    # >>> python
    ruff
    ty
    # <<< python
    rumdl
    shellcheck
    shellharden
    shfmt
    statix
    # >>> lua
    stylua
    # <<< lua
    taplo
    treefmt
    typos
    # >>> yamlfmt
    yamlfmt
    # <<< yamlfmt
  ];
  shellHook = # sh
    ''
      prek install --quiet
    '';
}
