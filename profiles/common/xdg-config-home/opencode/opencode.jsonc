{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    // https://opencode.ai/v2/docs/permissions
    { "action": "websearch", "resource": "*", "effect": "allow" },
    // use `pnpm` instead
    { "action": "shell", "resource": "npm *", "effect": "deny" },
    { "action": "shell", "resource": "npx *", "effect": "deny" },
    // use `nix` instead
    { "action": "shell", "resource": "nix-env *", "effect": "deny" },
    // use `uvx` instead
    { "action": "shell", "resource": "pipx *", "effect": "deny" },
    // hardning
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "ssh admin*", "effect": "deny" },
    { "action": "shell", "resource": "ssh deploy*", "effect": "deny" },
    { "action": "shell", "resource": "sops*", "effect": "deny" },

    // Read dotfiles
    {
      "action": "read",
      "resource": "/home/hnjae/.local/share/dotfiles/*",
      "effect": "allow"
    }
  ],
  "formatter": {
    "prettier": {
      "disabled": true
    }
  }
}
