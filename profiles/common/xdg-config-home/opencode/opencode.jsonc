{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "websearch": {
    "provider": "exa"
  },
  "permissions": [
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "policies": [
    { "action": "tool.use", "resource": "shell:*sops *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*age -d *", "effect": "deny" },
    {
      "action": "tool.use",
      "resource": "shell:*age --decrypt*",
      "effect": "deny"
    },
    { "action": "tool.use", "resource": "shell:*gpg *-d *", "effect": "deny" },
    {
      "action": "tool.use",
      "resource": "shell:*gpg *--decrypt*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:*openssl enc *-d *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:*openssl enc *--decrypt*",
      "effect": "deny"
    }
  ],
  "mcp": {
    "servers": {
      "mdn": {
        "type": "remote",
        "url": "https://mcp.mdn.mozilla.net/"
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "kagi": {
        "type": "local",
        "command": ["kagi", "mcp", "--exclude-tools", "kagi_extract"]
      },
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "disabled": false,
        "codemode": false
      }
    }
  },
  "plugins": [
    "cc-safety-net@latest",
    "opencode-wakelock",
    "@madsoftwaredev/opencode-direnv"
  ]
}
