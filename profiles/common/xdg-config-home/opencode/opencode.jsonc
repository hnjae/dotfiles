{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "plan": {
      "model": "zai-coding-plan/glm-5.3-flash",
      "variant": "high"
    },
    "build": {
      "model": "zai-coding-plan/glm-5.3-flash",
      "variant": "low"
    }
  },
  "permission": {
    "read": {
      "/nix/store/**": "allow",
      "/tmp/**": "allow",
      "/home/hnjae/.local/share/cargo/**": "allow"
    },
    "glob": {
      "/nix/store/**": "allow",
      "/tmp/**": "allow",
      "/home/hnjae/.local/share/cargo/**": "allow"
    },
    "grep": {
      "/nix/store/**": "allow",
      "/tmp/**": "allow",
      "/home/hnjae/.local/share/cargo/**": "allow"
    },
    "list": {
      "/nix/store/**": "allow",
      "/tmp/**": "allow",
      "/home/hnjae/.local/share/cargo/**": "allow"
    },
    "external_directory": {
      "/nix/store/**": "allow",
      "/tmp/**": "allow",
      "/home/hnjae/.local/share/cargo/**": "allow"
    },
    "bash": {
      "npm *": "deny",
      "npx *": "deny",
      "sudo *": "deny",
      "nix-env *": "deny",
      "sops": "deny",
      "ssh admin*": "deny",
      "ssh deploy*": "deny"
    }
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "basedpyright": {
      "disabled": true
    },
    "ty": {
      "command": ["ty", "server"],
      "extensions": [".py", ".pyi"]
    },
    "qmlls": {
      "command": ["qmlls", "--no-cmake-calls"],
      "extensions": [".qml"]
    },
    "docker-ls": {
      "command": ["docker-language-server", "start"],
      "extensions": ["Containerfile", "Dockerfile"]
    }
  },
  "plugin": [
    "@mohak34/opencode-notifier@latest",
    "@simonwjackson/opencode-direnv"
  ]
}
