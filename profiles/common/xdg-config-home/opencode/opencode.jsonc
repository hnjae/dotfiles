{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "websearch": {
    "provider": "exa"
  },
  "permissions": [
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "mdn": {
        "type": "remote",
        "url": "https://mcp.mdn.mozilla.net/"
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "kagi": {
        "type": "local",
        "command": ["kagi", "mcp", "--exclude-tools", "kagi_extract"]
      }
    }
  },
  "plugins": [
    "cc-safety-net@latest",
    "opencode-wakelock",
    "@madsoftwaredev/opencode-direnv"
  ]
}
