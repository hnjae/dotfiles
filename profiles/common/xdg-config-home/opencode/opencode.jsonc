{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "websearch": {
    "provider": "exa"
  },
  "permissions": [
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "policies": [
    {
      "action": "tool.use",
      "resource": "shell:*age --decrypt*",
      "effect": "deny"
    }
  ],
  "mcp": {
    "servers": {
      "mdn": {
        "type": "remote",
        "url": "https://mcp.mdn.mozilla.net/"
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      // "codegraph": {
      //   "type": "local",
      //   "command": ["codegraph", "serve", "--mcp"],
      //   "disabled": false,
      //   "codemode": false
      // }
      "nixos": {
        "type": "local",
        "command": ["uvx", "mcp-nixos"]
      }
    }
  },
  "plugins": [
    "cc-safety-net@latest",
    "opencode-wakelock",
    "@madsoftwaredev/opencode-direnv"
  ]
}
