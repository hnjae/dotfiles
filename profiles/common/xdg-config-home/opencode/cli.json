{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "gruvbox",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show",
    "verbosity": "medium",
    "image_preview": true
  },
  "animations": true,
  "keybinds": {
    "session.first": "",
    "session.last": "",
    "prompt.editor": "ctrl+g"
  },
  "attention": {
    "volume": 1,
    "notifications": true,
    "sound": true
  },
  "prompt": {
    "image_preview": true
  },
  "tabs": {
    "layout": "horizontal",
    "scope": "cwd",
    "mode": "off"
  },
  "plugins": ["./herdr-opencode"]
}
