{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "gruvbox"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show"
  },
  "animations": true,
  "keybinds": {
    "prompt.editor": ["ctrl+g", "<leader>e"], // default `<leader>e`
    "session.compact": "", // default `<leader>c`
    "app_exit": "" // default `<leader>q`
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "basedpyright": {
      "disabled": true
    },
    "ty": {
      "command": ["ty", "server"],
      "extensions": [".py", ".pyi"]
    },
    "qmlls": {
      "command": ["qmlls", "--no-cmake-calls"],
      "extensions": [".qml"]
    },
    "docker-ls": {
      "command": ["docker-language-server", "start"],
      "extensions": ["Containerfile", "Dockerfile"]
    }
  }
}
