{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "gruvbox",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show",
    "verbosity": "medium",
    "image_preview": true
  },
  "animations": true,
  "keybinds": {
    "session.first": "",
    "session.last": "",
    "prompt.editor": "ctrl+g"
  },
  "attention": {
    "volume": 1,
    "notifications": true,
    // 이거 true 이면 alsa 없는 system 에서 tui 를 정상적으로 못씀.
    "sound": false
  },
  "prompt": {
    "image_preview": true
  },
  "tabs": {
    "layout": "horizontal",
    "scope": "cwd",
    "mode": "off"
  },
  "plugins": ["./herdr-opencode"]
}
