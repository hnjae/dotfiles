{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "mdn": {
        "type": "remote",
        "url": "https://mcp.mdn.mozilla.net/"
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "kagi": {
        "type": "local",
        "command": [
          "kagi",
          "mcp",
          "--exclude-tools",
          "kagi_extract"
        ]
      }
    }
  }
}
