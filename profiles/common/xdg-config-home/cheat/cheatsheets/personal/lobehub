395:   const canShowExecutionTarget = canUseResource && canDisplayExecutionTarget;
396:   const canShowExecutionTargetSelector = canShowExecutionTarget && canSelectExecutionTarget;
397:
398:   const heteroType = agencyConfig?.heterogeneousProvider?.type;
399:   const boundDeviceId = agencyConfig?.boundDeviceId;
