414:   // description instead of the generic online/offline status.
415:   useElectronStore((s) => s.useFetchGatewayDeviceInfo)();
416:   const gatewayDeviceInfo = useElectronStore((s) => s.gatewayDeviceInfo);
417:   const currentDeviceId = isDesktop ? gatewayDeviceInfo?.deviceId : undefined;
418:   const [reconnectingDeviceId, setReconnectingDeviceId] = useState<string>();
