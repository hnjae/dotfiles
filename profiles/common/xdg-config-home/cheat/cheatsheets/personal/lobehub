420:   const handleReconnectDevice = useCallback(
421:     async (deviceId: string) => {
422:       setReconnectingDeviceId(deviceId);
423:       try {
424:         if (isDesktop && deviceId === currentDeviceId) {
425:           await useElectronStore.getState().connectGateway();
426:         } else {
