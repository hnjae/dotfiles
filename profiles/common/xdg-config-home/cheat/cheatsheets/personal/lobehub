export const useDeviceList = (): SWRResponse<DeviceListItem[]> => {
  const isLogin = useUserStore(authSelectors.isLogin);
  return useClientDataSWR<DeviceListItem[]>(
    isLogin || isDesktop ? [DEVICE_LIST_SWR_KEY] : null,
