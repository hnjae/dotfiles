430:         // The deep link crosses browser → desktop → gateway → server, so give
431:         // the live device registry a short window to converge instead of
432:         // making the user close and reopen the picker to see the result.
433:         let connected = false;
434:         for (let attempt = 0; attempt < 8; attempt += 1) {
435:           const nextDevices = await refreshDevices();
436:           if (nextDevices?.some((device) => device.deviceId === deviceId && device.online)) {
