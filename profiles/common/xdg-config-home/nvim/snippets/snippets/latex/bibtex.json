{
  "article": {
    "prefix": "article",
    "description": "article from a journal, magazine, newspaper",
    "body": [
      "@article{${1:key},",
      "\tauthor  = {${2:author}},",
      "\ttitle   = {${3:title}},",
      "\tjournal = {${4:journal}},",
      "\tyear    = {${5:YYYY}},",
      "\t% volume  = {${6:NN}},",
      "\t% number  = {${7:NN}},",
      "\t% pages   = {${8:NN}--${9:NN}},",
      "\t% month   = {${10:MMM}},",
      "\t% note    = {}",
      "}",
      "$0"
    ]
  },
  "book": {
    "prefix": "book",
    "description": "published book",
    "body": [
      "@book{${1:key},",
      "\tauthor    = {${2:author}}, % author or editor",
      "\ttitle     = {${3:title}},",
      "\tpublisher = {${4:publisher}},",
      "\tyear      = {${6:YYYY}}",
      "\t% address   = {${5:New York, NY}},",
      "\t% volume    = {}, % volume or number",
      "\t% series    = {},",
      "\t% edition   = {},",
      "\t% month     = {},",
      "\t% note      = {}",
      "}",
      "$0"
    ]
  },
  "booklet": {
    "prefix": "booklet",
    "description": "book without publisher or institution",
    "body": [
      "@booklet{${1:key},",
      "\ttitle        = {${2:title}},",
      "\t% author       = {${3:author}},",
      "\t% howpublished = {${4:how}},",
      "\t% address      = {},",
      "\t% month        = {${5:MMM}},",
      "\t% year         = {${6:YYYY}},",
      "\t% note         = {}",
      "}",
      "$0"
    ]
  },
  "inbook": {
    "prefix": "inbook",
    "description": "Part of a book (section, chapter)",
    "body": [
      "@inbook{${1:key},",
      "\tauthor    = {${2:author}}, % or editor",
      "\ttitle     = {${3:title}},",
      "\tchapter   = {}, % and/or pages",
      "\tpages     = {${8:NN}--${9:NN}},",
      "\tpublisher = {${6:publisher}},",
      "\tyear      = {${5:YYYY}},",
      "\t% address   = {${7:NewYork, NY}},",
      "\t% volume    = {}, % or number",
      "\t% series    = {},",
      "\t% type      = {},",
      "\t% edition   = {},",
      "\t% month     = {},",
      "\t% note      = {},",
      "}",
      "$0"
    ]
  },
  "incollection": {
    "prefix": "incollection",
    "description": "part of a book having its own title",
    "body": [
      "@incollection{${1:key},",
      "\tauthor    = {${2:author}},",
      "\ttitle = {},",
      "\tbooktitle = {},",
      "\tpublisher,",
      "\tyear,",
      "\t% volume or number",
      "\t% editor",
      "\t% series",
      "\t% type",
      "\t% chapter",
      "\t% pages",
      "\t% address",
      "\t% edition",
      "\t% month",
      "\t% note",
      "}",
      "$0"
    ]
  },
  "inproceedings": {
    "prefix": "inproceedings",
    "description": "paper published in conference proceedings",
    "body": [
      "@inproceedings{${1:key},",
      "\tauthor    = {${2:author}},",
      "\ttitle,",
      "\tbooktitle,",
      "\tyear,",
      "\t% editor",
      "\t% volume or number",
      "\t% series",
      "\t% pages",
      "\t% address",
      "\t% month",
      "\t% organization",
      "\t% publisher",
      "\t% note",
      "}",
      "$0"
    ]
  },
  "manual": {
    "prefix": "manual",
    "description": "technical manual",
    "body": [
      "@manual{${1:key},",
      "\ttitle    = {${2:title}},",
      "\t% author",
      "\t% organization",
      "\t% address",
      "\t% edition",
      "\t% month",
      "\t% year",
      "\t% note [also available at \\\\url]",
      "}",
      "$0"
    ]
  },
  "mastersthesis": {
    "prefix": "mastersthesis",
    "description": "mastersthesis",
    "body": [
      "@mastersthesis{${1:key},",
      "\tauthor    = {${2:author}},",
      "\ttitle,",
      "\tschool,",
      "\tyear",
      "\t% type",
      "\t% address",
      "\t% month",
      "\t% note",
      "}",
      "$0"
    ]
  },
  "misc": {
    "prefix": "misc",
    "description": "web pages, lecture slides, note",
    "body": [
      "@misc{${1:key},",
      "\ttitle        = {${2:title}},",
      "\tauthor       = {${3:author}},",
      "\thowpublished = {${4:\\\\url}},",
      "\tmonth        = {},",
      "\tyear         = {${5:year}},",
      "\tnote         = {[Online; accessed ${6:yyyy-mm-dd}}",
      "}",
      "$0"
    ]
  },
  "phdthesis": {
    "prefix": "phdthesis",
    "description": "phdthesis",
    "body": [
      "@phdthesis{${1:key},",
      "\tauthor    = {${2:author}},",
      "\ttitle,",
      "\tschool,",
      "\tyear,",
      "\t% type",
      "\t% address,",
      "\t% month,",
      "\t% note",
      "}",
      "$0"
    ]
  },
  "proceedings": {
    "prefix": "proceedings",
    "description": "conference proceeding",
    "body": [
      "@proceedings{${1:key},",
      "\ttitle,",
      "\tyear",
      "\t% editor",
      "\t% volume or number",
      "\t% series",
      "\t% address",
      "\t% month",
      "\t% organization",
      "\t% publisher",
      "\t% note",
      "}",
      "$0"
    ]
  },
  "techreport": {
    "prefix": "techreport",
    "description": "institutionally published report",
    "body": [
      "@techreport{${1:key},",
      "\ttitle       = {${2:title}},",
      "\tauthor      = {${3:author}},",
      "\tinstitution = {${4:... Corporation}},",
      "\tyear        = {${7:YYYY}},",
      "\t% month        = {${8:}}",
      "\t% address     = {${5:NewYork, NY}},",
      "\t% number      = {${6:DOE-SLC-6903-1}},",
      "\t% type",
      "\t% note",
      "}",
      "$0"
    ]
  },
  "unpublished": {
    "prefix": "unpublished",
    "description": "has not been officially published",
    "body": [
      "@unpublished{${1:key},",
      "\tauthor      = {${2:author}},",
      "\ttitle       = {${3:title}},",
      "\tnote        = {},",
      "\t% year        = {${4:YYYY}},",
      "\t% month",
      "}",
      "$0"
    ]
  }
}
