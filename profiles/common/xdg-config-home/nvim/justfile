#!/usr/bin/env -S just --justfile

set fallback

_:
    @just --list

[group('ci')]
lint:
    fd --type f --extension lua . -X selene --allow-warnings

[group('ci')]
check: lint
    just --justfile "$(realpath '{{ justfile_directory() }}/../../../../justfile')" check

format:
    just --justfile "$(realpath '{{ justfile_directory() }}/../../../../justfile')" format
